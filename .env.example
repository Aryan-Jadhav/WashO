# =====================================================================
# WashO settings template.
# setup.bat copies this file to ".env" and creates a random SECRET_KEY.
# Then open .env and fill in DB_PASSWORD (and anything else you change).
# .env is ignored by Git, so real passwords are never uploaded.
# =====================================================================

# --- Django -----------------------------------------------------------
# Long random secret used to sign sessions/cookies. setup.bat fills this in.
SECRET_KEY=change-me-to-a-long-random-string
# True while developing (shows detailed error pages). Use False in production.
DEBUG=True
# Comma-separated host names allowed to serve the site.
ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL database ----------------------------------------------
DB_NAME=washo
DB_USER=washo_user
DB_PASSWORD=PUT_YOUR_DB_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=5432

# --- Email ------------------------------------------------------------
# Console backend = emails are printed in the terminal instead of being sent.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=WashO <no-reply@washo.local>

# --- Support contact details shown on the website ---------------------
SUPPORT_EMAIL=support@washo.local
SUPPORT_PHONE=+91 20 4000 0000

# --- Razorpay TEST keys (used from Phase 6) ---------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
