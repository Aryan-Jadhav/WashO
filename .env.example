# WashO settings. Copy this file to ".env" and fill in real values.
# .env is ignored by Git, so your passwords never get uploaded.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
DB_NAME=washo
DB_USER=washo_user
DB_PASSWORD=PUT_YOUR_DB_PASSWORD_HERE
DB_HOST=localhost
DB_PORT=5432

# Razorpay TEST keys (filled in Phase 6)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=